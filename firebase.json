{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "index.html"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "dth-tamizhan",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "run": { "serviceId": "dth-tamizhan", "region": "asia-south1" }
      }
    ]
  },
  "firestore": {
    "database": "ai-studio-dthtamizhan-ab9bf4ab-c166-4e84-a763-9f8a48360247",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": false
    }
  }
}
