# Public recharge launch switch: unset/false disables NEW checkout. Keep recovery/webhooks active.
RECHARGE_ENABLED=false
# Free-tier recommendation settings are documented below. The legacy
# GEMINI_API_KEY / GOOGLE_API_KEY are deliberately not used for recommendations.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay secret is server-only. Never prefix the secret with VITE_.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Local Firebase Admin: absolute path to a service-account JSON kept outside the repo.
# Cloud deployments may use the platform service account instead.
# GOOGLE_APPLICATION_CREDENTIALS="C:/secure/firebase-service-account.json"
VITE_RAZORPAY_KEY_ID=""

# WHATSAPP_API_TOKEN: Cloud API token for sending SMS/WhatsApp recharge receipts
WHATSAPP_API_TOKEN="MY_WHATSAPP_API_TOKEN"


# Only payment mode switch. Read at server runtime; browser fetches /api/payments/config.
# production uses Razorpay (test/live is determined by your Razorpay keys).
# sandbox uses the local simulator without contacting Razorpay.
PAYMENT_MODE="sandbox"

# Brevo transactional receipts (server-only; free plan sending allowance).
# Enable after Brevo approves your sender and activates transactional email.
BREVO_ENABLED="false"
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="support@dthtamizhan.in"
BREVO_SENDER_NAME="DTH Tamizhan"
# Recharge and booking alerts go to orders@dthtamizhan.in; sent through Brevo.
ADMIN_ORDER_ALERTS_ENABLED="true"
# Conservative app cap per rolling 24 hours; never exceeds 300.
BREVO_DAILY_LIMIT="300"
# Enable explicitly to send clearly labeled receipts for Razorpay test payments.
BREVO_SEND_TEST_EMAILS="false"
# Optional: random secret of at least 32 characters for a deployment scheduler.
# POST /api/internal/email/process with Authorization: Bearer <this secret>.
EMAIL_WORKER_TOKEN=""

# Phone OTP sign-in is opt-in; real SMS requires Firebase Blaze billing.
# Enable the Phone provider, configure SMS regions/domains, then set true.
# Firebase fictional phone numbers can test the flow without sending SMS.
FIREBASE_PHONE_AUTH_ENABLED="false"

# Production always requires Firestore; file is allowed only for local development.
# Uses the existing named database in firebase-applet-config.json and server ADC.
PERSISTENCE_DRIVER="firestore"

# Optional free-tier Gemini recommendations. Use a key from a separate UNBILLED project.
# Server ADC must have apikeys.keys.lookup and resourcemanager.projects.get there.
# Missing permissions, unknown billing, or a linked billing account blocks all Gemini calls.
GEMINI_FREE_ENABLED="false"
GEMINI_FREE_API_KEY=""
# App-wide daily ceiling (default/hard max 500); confirm your AI Studio limits.
# Shared rolling-minute limit is 15. Google can impose lower limits.
GEMINI_FREE_DAILY_LIMIT="500"
# Optional per-customer ceiling; defaults to the app ceiling and cannot exceed it.
GEMINI_FREE_CUSTOMER_DAILY_LIMIT="500"
# Optional quota/consumer project for Google's metadata verification APIs.
# Defaults to the Firebase project; does not set Gemini's billing project.
# GEMINI_VERIFICATION_PROJECT_ID="your-verification-project"

# Support / service requests: App Check site key is public; secrets below are server-only.
VITE_FIREBASE_APPCHECK_SITE_KEY=""
# Public runtime fallback for deployed builds (same registered reCAPTCHA Enterprise site key).
FIREBASE_APPCHECK_SITE_KEY=""
SERVICE_RAZORPAY_WEBHOOK_SECRET=""
TICKET_SCHEDULER_SECRET=""
# TICKET_STORAGE_BUCKET="your-project.firebasestorage.app"

# Server-only Way2API DTH details lookup. Never use a VITE_ prefix for this key.
# Demo mode works without a key; live lookup can consume credits or wallet funds.
WAY2API_API_KEY=""
# Fallback 1: https://planapi.in/ApiDocument.aspx
PLANAPI_MEMBER_ID=""
PLANAPI_API_PASSWORD=""
# Fallback 2: DataYuge DTH customer details (server-only).
DATAYUGE_API_KEY=""
# Required to enable DataYuge: JSON mapping from a verified sample response.
# Keys: successPath (dot path), successValue (boolean/string/number), fields
# (canonical field names -> dot paths). See docs/dth-lookup.md.
DATAYUGE_DTH_RESPONSE_MAP=""
# Customer lookup is enabled when the server key is present; false disables it.
DTH_CUSTOMER_LOOKUP_ENABLED="true"
# App-wide customer lookup attempts per UTC day (default 100, hard ceiling 500).
# Individual signed-in customers can use up to 20 provider attempts per day.
# Each fallback counts as another provider attempt.
DTH_CUSTOMER_LOOKUP_DAILY_LIMIT="100"

# Recharge payment recovery: configure this webhook secret in Razorpay (same key mode).
RAZORPAY_RECHARGE_WEBHOOK_SECRET=""
# Protect POST /api/internal/recharges/reconcile when using an external scheduler.
RECHARGE_SCHEDULER_SECRET=""
# Long-running servers check durable pending orders every minute.
RECHARGE_RECONCILIATION_ENABLED="true"
# Production CSP starts report-only. Set enforce only after testing auth/checkout reports.
CSP_MODE="report-only"


# New-connection booking is payment-free by default in appSettings/newConnection.
# These flags do not change recharge payment mode. Razorpay live keys are rejected.
NC_RAZORPAY_TEST_ENABLED="false"
